// InsightHub — PostgreSQL schema
// Auth entities follow the Auth.js Prisma adapter contract; analytics entities
// are scoped to a Project which belongs to an Organization (workspace).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth & tenancy
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  ANALYST
  VIEWER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  memberships         Membership[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  savedReports        SavedReport[]
  alerts              Alert[]
  passwordResetTokens PasswordResetToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("pro")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  projects      Project[]
  savedReports  SavedReport[]
  dashboards    Dashboard[]
  alerts        Alert[]
  notifications Notification[]
  auditLogs     AuditLog[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  role      Role     @default(VIEWER)
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
}

model Project {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  domain    String
  timezone  String   @default("UTC")
  createdAt DateTime @default(now())

  org          Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  visitors     Visitor[]
  sessions     AnalyticsSession[]
  pageViews    PageView[]
  events       Event[]
  eventDefs    EventDefinition[]
  transactions RevenueTransaction[]
  products     Product[]
  savedReports SavedReport[]
  alerts       Alert[]

  @@index([orgId])
}

// ---------------------------------------------------------------------------
// Analytics — tracked end-users, sessions, page views, events
// ---------------------------------------------------------------------------

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
}

enum TrafficSource {
  ORGANIC
  DIRECT
  SOCIAL
  REFERRAL
  PAID
  EMAIL
}

enum VisitorStatus {
  ACTIVE
  DORMANT
  CHURNED
}

model Visitor {
  id            String        @id @default(cuid())
  projectId     String
  anonId        String
  name          String?
  email         String?
  country       String
  region        String?
  city          String?
  device        DeviceType
  browser       String
  os            String?
  source        TrafficSource
  status        VisitorStatus @default(ACTIVE)
  firstSeenAt   DateTime
  lastSeenAt    DateTime
  sessionsCount Int           @default(0)
  totalRevenue  Decimal       @default(0) @db.Decimal(12, 2)

  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sessions     AnalyticsSession[]
  pageViews    PageView[]
  events       Event[]
  transactions RevenueTransaction[]

  @@unique([projectId, anonId])
  @@index([projectId, lastSeenAt])
  @@index([projectId, firstSeenAt])
  @@index([projectId, country])
  @@index([projectId, email])
}

model AnalyticsSession {
  id             String        @id @default(cuid())
  projectId      String
  visitorId      String
  startedAt      DateTime
  endedAt        DateTime
  durationSec    Int
  device         DeviceType
  browser        String
  os             String?
  country        String
  region         String?
  city           String?
  source         TrafficSource
  landingPage    String
  exitPage       String
  pageViewsCount Int           @default(0)
  converted      Boolean       @default(false)

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  visitor   Visitor    @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  pageViews PageView[]
  events    Event[]

  @@index([projectId, startedAt])
  @@index([projectId, source, startedAt])
  @@index([projectId, country, startedAt])
  @@index([projectId, device, startedAt])
  @@index([visitorId, startedAt])
}

model PageView {
  id          String   @id @default(cuid())
  projectId   String
  sessionId   String
  visitorId   String
  path        String
  title       String?
  occurredAt  DateTime
  durationSec Int      @default(0)
  bounced     Boolean  @default(false)

  project Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  session AnalyticsSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  visitor Visitor          @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([projectId, occurredAt])
  @@index([projectId, path, occurredAt])
  @@index([sessionId])
  @@index([visitorId])
}

model EventDefinition {
  id           String   @id @default(cuid())
  projectId    String
  name         String
  description  String?
  isConversion Boolean  @default(false)
  createdAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events  Event[]

  @@unique([projectId, name])
  @@index([projectId])
}

model Event {
  id           String   @id @default(cuid())
  projectId    String
  definitionId String?
  name         String
  visitorId    String
  sessionId    String?
  occurredAt   DateTime
  metadata     Json?

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  definition EventDefinition?  @relation(fields: [definitionId], references: [id], onDelete: SetNull)
  visitor    Visitor           @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  session    AnalyticsSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([projectId, name, occurredAt])
  @@index([projectId, occurredAt])
  @@index([visitorId, occurredAt])
  @@index([sessionId])
}

// ---------------------------------------------------------------------------
// Revenue
// ---------------------------------------------------------------------------

enum TransactionStatus {
  SUCCEEDED
  PENDING
  REFUNDED
  FAILED
}

enum TransactionType {
  ONE_TIME
  SUBSCRIPTION
  RENEWAL
}

model Product {
  id        String   @id @default(cuid())
  projectId String
  name      String
  category  String
  price     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  transactions RevenueTransaction[]

  @@unique([projectId, name])
}

model RevenueTransaction {
  id         String            @id @default(cuid())
  projectId  String
  visitorId  String?
  productId  String
  amount     Decimal           @db.Decimal(12, 2)
  currency   String            @default("USD")
  status     TransactionStatus @default(SUCCEEDED)
  type       TransactionType   @default(ONE_TIME)
  segment    String            @default("smb")
  country    String
  occurredAt DateTime

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  visitor Visitor? @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([projectId, occurredAt])
  @@index([projectId, status, occurredAt])
  @@index([productId])
  @@index([visitorId])
}

// ---------------------------------------------------------------------------
// Reports, dashboards, alerts, notifications, audit
// ---------------------------------------------------------------------------

enum ReportSchedule {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

model SavedReport {
  id          String         @id @default(cuid())
  orgId       String
  projectId   String?
  createdById String?
  name        String
  description String?
  config      Json
  schedule    ReportSchedule @default(NONE)
  lastRunAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orgId, updatedAt])
}

model Dashboard {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  isDefault Boolean  @default(false)
  layout    Json?
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

enum AlertMetric {
  REVENUE
  ACTIVE_USERS
  NEW_USERS
  SESSIONS
  CONVERSION_RATE
  PAGE_VIEWS
  ERROR_RATE
}

enum AlertCondition {
  ABOVE
  BELOW
  INCREASES_BY_PCT
  DECREASES_BY_PCT
}

enum AlertFrequency {
  HOURLY
  DAILY
  WEEKLY
}

model Alert {
  id              String         @id @default(cuid())
  orgId           String
  projectId       String?
  createdById     String?
  name            String
  metric          AlertMetric
  condition       AlertCondition
  threshold       Float
  frequency       AlertFrequency @default(DAILY)
  channels        String[]       @default(["IN_APP"])
  isActive        Boolean        @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orgId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  orgId     String?
  type      String    @default("info")
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  orgId      String
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
}
