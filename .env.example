# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (docker-compose default shown)
DATABASE_URL="postgresql://insighthub:insighthub@localhost:5432/insighthub?schema=public"

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-generate-a-random-32-byte-secret"
# Canonical app URL (used in emails and auth callbacks)
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Optional OAuth providers (architecture is OAuth-ready; leave unset to disable)
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# ── Redis (optional) ────────────────────────────────────────────────────────
# Used for query caching and rate limiting. The app degrades gracefully to an
# in-memory fallback when unset (fine for a single instance / local dev).
REDIS_URL="redis://localhost:6379"

# ── Email (optional) ────────────────────────────────────────────────────────
# SMTP settings for password-reset and alert emails.
# When unset, emails are logged to the server console instead (dev mode).
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# EMAIL_FROM="InsightHub <no-reply@insighthub.local>"

# ── Object storage (optional, S3-compatible) ────────────────────────────────
# Used for report exports. Local dev can use MinIO from docker-compose.
# S3_ENDPOINT="http://localhost:9000"
# S3_REGION="us-east-1"
# S3_BUCKET="insighthub-exports"
# S3_ACCESS_KEY_ID="insighthub"
# S3_SECRET_ACCESS_KEY="insighthub-secret"
